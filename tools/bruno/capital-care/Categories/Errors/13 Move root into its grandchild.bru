meta {
  name: 13 Move root into its grandchild
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/categories/{{treeRootId}}
  body: json
  auth: none
}

body:json {
  { "parentId": "{{treeLeafId}}" }
}
assert {
  res.status: eq 400
  res.body.type: eq ValidationError
  res.body.detail: eq a category cannot be moved into itself or its descendants
}

