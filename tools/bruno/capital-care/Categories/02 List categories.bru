meta {
  name: 02 List categories
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/categories
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.categories: isArray
}

tests {
  test("includes the category created in step 01", function() {
    const ids = res.body.categories.map(function(c) { return c.id; });
    expect(ids).to.include(bru.getVar("categoryId"));
  });

  test("is sorted by name ascending by default", function() {
    const names = res.body.categories.map(function(c) { return c.name; });
    expect(names).to.deep.equal([...names].sort());
  });
}
