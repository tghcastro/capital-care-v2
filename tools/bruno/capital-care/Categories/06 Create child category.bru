meta {
  name: 06 Create child category
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Produce {{$timestamp}}",
    "parentId": "{{categoryId}}"
  }
}

assert {
  res.status: eq 201
  res.body.parentId: eq {{categoryId}}
}

script:post-response {
  bru.setVar("childId", res.body.id);
}
