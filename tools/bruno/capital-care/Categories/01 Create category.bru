meta {
  name: 01 Create category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Groceries-{{$timestamp}}",
    "description": "Food and household items"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.userId: eq {{userId}}
  res.body.name: startsWith Groceries-
  res.body.description: eq Food and household items
  res.body.createdAt: isString
  res.body.updatedAt: isString
}

script:post-response {
  bru.setVar("categoryId", res.body.id);
  bru.setVar("categoryName", res.body.name);
}
