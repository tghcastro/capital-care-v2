meta {
  name: 05 Create duplicate name ignoring case
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

body:json {
  {
    "name": "{{duplicateNameUpper}}"
  }
}

assert {
  res.status: eq 409
  res.body.type: eq ConflictError
  res.body.detail: eq An account with this name already exists
}
