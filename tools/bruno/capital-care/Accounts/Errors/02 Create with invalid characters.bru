meta {
  name: 02 Create with invalid characters
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

body:json {
  {
    "name": "Bank-A"
  }
}

assert {
  res.status: eq 400
  res.body.type: eq ValidationError
  res.body.detail: eq name may contain only letters, digits and spaces
}
