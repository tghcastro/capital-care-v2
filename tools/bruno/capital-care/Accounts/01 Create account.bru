meta {
  name: 01 Create account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

body:json {
  {
    "name": "Bank {{$timestamp}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.userId: eq {{userId}}
  res.body.name: startsWith Bank
  res.body.createdAt: isString
  res.body.updatedAt: isString
}

script:post-response {
  bru.setVar("accountId", res.body.id);
  bru.setVar("accountName", res.body.name);
}
