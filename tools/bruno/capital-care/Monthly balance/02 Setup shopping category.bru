meta {
  name: 02 Setup shopping category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Shopping {{$timestamp}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("mbShoppingCategoryId", res.body.id);
}
