meta {
  name: 14 Balance January after the move
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/transactions/balance?month=2027-01&account={{mbAccountId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("January counts it and ends where December used to", function() {
    expect(res.body.days).to.eql([{ date: "2027-01-02", balance: "2661" }]);
    expect(res.body.totals).to.eql({ received: "0", debits: "110", net: "-110", finalBalance: "2661" });
  });
}
