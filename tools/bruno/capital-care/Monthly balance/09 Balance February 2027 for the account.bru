meta {
  name: 09 Balance February 2027 for the account
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/transactions/balance?month=2027-02&account={{mbAccountId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("an empty month carries the last closing balance forward", function() {
    expect(res.body.days).to.eql([]);
    expect(res.body.totals).to.eql({ received: "0", debits: "0", net: "0", finalBalance: "2661" });
  });
}
