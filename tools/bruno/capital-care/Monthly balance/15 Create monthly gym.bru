meta {
  name: 15 Create monthly gym
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: none
}

body:json {
  {
    "date": "2027-01-10",
    "description": "Gym {{$timestamp}}",
    "categoryId": "{{mbShoppingCategoryId}}",
    "accountId": "{{mbAccountId}}",
    "amount": "50.00",
    "type": "debit",
    "recurrence": "monthly"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("mbGymId", res.body.id);
}
