meta {
  name: 08 Balance December for the account
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/transactions/balance?month=2026-12&account={{mbAccountId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("December carries November's 2771 over", function() {
    expect(res.body.days).to.eql([{ date: "2026-12-10", balance: "2661" }]);
    expect(res.body.totals).to.eql({ received: "0", debits: "110", net: "-110", finalBalance: "2661" });
  });
}
