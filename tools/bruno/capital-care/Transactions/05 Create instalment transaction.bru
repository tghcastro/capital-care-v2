meta {
  name: 05 Create instalment transaction
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: none
}

body:json {
  {
    "date": "2026-11-15",
    "description": "Car loan {{$timestamp}}",
    "categoryId": "{{txCategoryId}}",
    "accountId": "{{txAccountId}}",
    "amount": "650.00",
    "type": "debit",
    "instalment": {
      "number": 17,
      "total": 48
    }
  }
}

assert {
  res.status: eq 201
  res.body.recurrence: isNull
  res.body.instalment.number: eq 17
  res.body.instalment.total: eq 48
}

script:post-response {
  bru.setVar("txInstalmentId", res.body.id);
}
