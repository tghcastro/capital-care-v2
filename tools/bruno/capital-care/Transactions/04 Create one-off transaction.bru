meta {
  name: 04 Create one-off transaction
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: none
}

body:json {
  {
    "date": "2026-11-10",
    "description": "New office chair {{$timestamp}}",
    "categoryId": "{{txCategoryId}}",
    "accountId": "{{txAccountId}}",
    "amount": "229.00",
    "type": "debit"
  }
}

assert {
  res.status: eq 201
  res.body.date: eq 2026-11-10
  res.body.recurrence: isNull
  res.body.instalment: isNull
}

script:post-response {
  bru.setVar("txOneOffId", res.body.id);
}

tests {
  test("amount is 229, written as a canonical string", function() {
    expect(res.body.amount).to.equal("229");
  });
}
