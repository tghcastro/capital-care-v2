meta {
  name: 11 Edit transaction of another user
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/transactions/{{ownedTransactionId}}/occurrences/2026-11-05
  body: json
  auth: none
}

headers {
  X-User-Id: {{otherUserId}}
}

body:json {
  {
    "amount": "1.00"
  }
}

assert {
  res.status: eq 404
  res.body.type: eq NotFoundError
}
