meta {
  name: 01 Create with invalid type
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: none
}

body:json {
  {
    "date": "2026-11-05",
    "description": "Condo fees {{$timestamp}}",
    "categoryId": "any-category",
    "accountId": "any-account",
    "amount": "450.00",
    "type": "expense"
  }
}

assert {
  res.status: eq 400
  res.body.type: eq ValidationError
  res.body.detail: contains type
}
