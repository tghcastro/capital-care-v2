# Database configuration
DB_PATH=./data/capital-care.db

# Account limit: the most accounts one user may have (a whole number of at least 1).
# Development uses 5 so the limit is easy to test. Leave it unset in production: the default is 99.
ACCOUNT_LIMIT=5

# Server configuration
PORT=3000

# Node environment
NODE_ENV=development

# Docker Compose overrides DB_PATH and PORT inside the container.
# API_PORT sets the host port for the Docker services: DEV defaults to 3000,
# PRD defaults to 8000 (see docker-compose.dev.yml and docker-compose.prd.yml).
