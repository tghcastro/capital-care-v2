# Database configuration
DB_PATH=./data/capital-care.db

# Account limit: the most accounts one user may have (a whole number of at least 1).
# Development uses 5 so the limit is easy to test. Leave it unset in production: the default is 99.
ACCOUNT_LIMIT=5

# Server configuration
PORT=3000

# Web app: directory of the built web app (apps/web/dist) that the API serves on its own port.
# Leave it unset in local API development: no static files are served. The Docker image sets it
# to /app/public.
# WEB_DIST_PATH=./apps/web/dist

# Node environment
NODE_ENV=development

# Docker Compose overrides DB_PATH and PORT inside the container (see docker-compose.yml).
# DEV_PORT and PRD_PORT set the host port for the `dev` and `prod` profiles,
# defaulting to 3000 and 8000 respectively.
