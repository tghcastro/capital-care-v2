{
  "name": "capital-care",
  "version": "0.0.1",
  "description": "A lightweight personal finance tracker",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "clean": "rm -rf apps/*/dist modules/*/dist packages/*/dist tsconfig.tsbuildinfo apps/*/tsconfig.tsbuildinfo modules/*/tsconfig.tsbuildinfo packages/*/tsconfig.tsbuildinfo",
    "build": "tsc -b && pnpm --filter @capital-care/web build && cp -r modules/ledger/src/shared/persistence/migrations modules/ledger/dist/shared/persistence/",
    "build:watch": "tsc -b --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "pnpm -r type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node apps/api/dist/migrate.js",
    "db:generate": "pnpm --filter @capital-care/ledger db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "modules/ledger",
    "packages/shared"
  ]
}
