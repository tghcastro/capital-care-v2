{
  "name": "capital-care",
  "version": "0.0.1",
  "description": "A lightweight personal finance tracker",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "clean": "rm -rf apps/*/dist modules/*/dist packages/*/dist tsconfig.tsbuildinfo apps/*/tsconfig.tsbuildinfo modules/*/tsconfig.tsbuildinfo packages/*/tsconfig.tsbuildinfo",
    "build": "tsc -b && cp -r modules/ledger/src/shared/persistence/migrations modules/ledger/dist/shared/persistence/",
    "build:watch": "tsc -b --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node apps/api/dist/migrate.js",
    "db:generate": "pnpm --filter @capital-care/ledger db:generate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "apps/api",
    "modules/ledger",
    "packages/shared"
  ]
}
